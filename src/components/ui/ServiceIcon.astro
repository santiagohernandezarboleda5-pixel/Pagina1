---
import { Image } from 'astro:assets';

interface Props {
  title: string;
  iconType: any;
  href: string;
}

const { title, iconType, href } = Astro.props;

function processTitle(text: string) {
  const words = text.trim().split(/\s+/);
  const lastWord = words[words.length - 1];
  const before = words.slice(0, -1).join(' ');
  return { beforeKeyword: before, keyword: lastWord };
}

const titleParts = processTitle(title);
const description = titleParts.keyword;
---

<a href={href} class="group block">
  <div class="bg-white rounded-full w-32 h-32 sm:w-40 sm:h-40 md:w-36 md:h-36 lg:w-48 lg:h-48 xl:w-56 xl:h-56 mx-auto flex flex-col items-center justify-center shadow-lg group-hover:shadow-xl transition-shadow">
    <div class="mb-2">
      <Image 
        src={iconType} 
        alt={`${title} icon`}
        class="w-12 h-12 sm:w-14 sm:h-14 object-contain"
      />
    </div>
    <div class="text-center px-2">
      <p class="text-xs sm:text-sm font-medium">{titleParts.beforeKeyword}</p>
      <p class="text-xs sm:text-sm font-bold text-blue-600">{titleParts.keyword}</p>
    </div>
  </div>
</a>
