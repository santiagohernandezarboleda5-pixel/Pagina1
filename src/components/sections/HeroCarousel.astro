---
const desktopSlides = ["/hero-carrousel.webp", "/hero-carrousel1.webp"];
const mobileSlides = ["/hero-carrousel_mobile.webp", "/hero-carrousel_mobile1.webp"];
---

<section class="relative h-[84vh] md:h-[600px] overflow-hidden">
  <!-- Desktop -->
  <div class="absolute inset-0 hidden md:block">
    {desktopSlides.map((img, idx) => (
      <img
        src={img}
        alt="Hero slide"
        class:list={["absolute inset-0 w-full h-full object-cover transition-opacity duration-700", idx === 0 ? "opacity-100" : "opacity-0"]}
        loading={idx === 0 ? "eager" : "lazy"}
      />
    ))}
  </div>

  <!-- Mobile -->
  <div class="absolute inset-0 block md:hidden">
    {mobileSlides.map((img, idx) => (
      <img
        src={img}
        alt="Hero slide mobile"
        class:list={["absolute inset-0 w-full h-full object-cover transition-opacity duration-700", idx === 0 ? "opacity-100" : "opacity-0"]}
        loading={idx === 0 ? "eager" : "lazy"}
      />
    ))}
  </div>

  <!-- Contenido encima -->
  <div class="relative z-10 h-full flex items-center">
    <div class="container mx-auto px-4">
      <h1 class="text-4xl md:text-6xl font-bold text-white">Polizas de salud, seguros de vida, con asesoria experta</h1>
    </div>
  </div>
</section>
